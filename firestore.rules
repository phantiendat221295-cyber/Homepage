rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tiện ích Webapps: Cho phép đọc công khai để sinh viên và giảng viên truy cập portal
    match /apps/{appId} {
      allow read: if true;
      allow write: if true; // Lưu ý: Có thể siết chặt theo request.auth khi bật Firebase Auth
    }

    // Yêu cầu hỗ trợ: Mọi người có thể gửi yêu cầu hỗ trợ, đọc và cập nhật trạng thái
    match /support_tickets/{ticketId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Cấu hình hệ thống & Google Sheets
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Thông báo đào tạo
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Kiểm tra quyền Super Admin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['datpt60@fpt.edu.vn', 'phantiendat221295@gmail.com'] ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin')
      );
    }

    // Danh sách phân quyền Quản trị viên (Admin)
    match /admin_users/{adminId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Chỉ cho phép update khi request.auth hợp lệ và người thực hiện update phải có role là superAdmin
      allow update: if request.auth != null && isSuperAdmin();
      allow delete: if request.auth != null && isSuperAdmin();
    }
  }
}
