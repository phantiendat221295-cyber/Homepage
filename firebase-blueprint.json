{
  "entities": {
    "WebApp": {
      "title": "WebApp",
      "description": "Thông tin ứng dụng web và tiện ích hỗ trợ quản lý đào tạo FPT",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "url": { "type": "string", "maxLength": 2048 },
        "category": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 50 },
        "tag": { "type": "string", "maxLength": 50 },
        "colorTheme": { "type": "string", "maxLength": 30 },
        "badge": { "type": "string", "maxLength": 50 },
        "isExternal": { "type": "boolean" },
        "isCustom": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "url", "category"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Yêu cầu hỗ trợ từ sinh viên và giảng viên gửi về ban quản trị",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "emailOrCode": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["new", "resolved"] },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "emailOrCode", "content", "status"]
    },
    "PortalConfig": {
      "title": "PortalConfig",
      "description": "Cấu hình liên kết Google Sheets và Google OAuth Client ID của cổng thông tin",
      "type": "object",
      "properties": {
        "appsCsvUrl": { "type": "string", "maxLength": 2048 },
        "notificationsCsvUrl": { "type": "string", "maxLength": 2048 },
        "permissionsCsvUrl": { "type": "string", "maxLength": 2048 },
        "gasWebhookUrl": { "type": "string", "maxLength": 2048 },
        "googleClientId": { "type": "string", "maxLength": 256 },
        "lastSynced": { "type": "string", "maxLength": 50 },
        "autoSync": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Thông báo sơ kết đào tạo hoặc tin tức từ nhà trường",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 50 },
        "url": { "type": "string", "maxLength": 2048 },
        "color": { "type": "string", "maxLength": 30 },
        "content": { "type": "string", "maxLength": 2000 },
        "isImportant": { "type": "boolean" }
      },
      "required": ["title", "date"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Tài khoản người dùng có quyền Quản trị viên (Admin)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["superAdmin", "admin", "user"] },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "isSuperAdmin": { "type": "boolean" },
        "addedAt": { "type": "string", "maxLength": 50 },
        "addedBy": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string", "maxLength": 100 },
        "lastLogin": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    },
    "SystemAuditLog": {
      "title": "SystemAuditLog",
      "description": "Nhật ký kiểm toán toàn hệ thống ghi nhận mọi thao tác quản trị",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "performedBy": { "type": "string", "maxLength": 100 },
        "performedByName": { "type": "string", "maxLength": 100 },
        "performedByUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE", "ASSIGN", "TOGGLE_CHECKLIST", "CONFIG_CHANGE"] },
        "targetType": { "type": "string", "enum": ["app", "notification", "admin_account", "portal_config", "support_ticket"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["timestamp", "performedBy", "action", "targetType", "targetId", "description"]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": "WebApp",
      "description": "Danh sách các webapp tiện ích đào tạo được lưu trên Firestore"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Danh sách yêu cầu phản ánh, hỗ trợ đào tạo"
    },
    "/settings/{settingId}": {
      "schema": "PortalConfig",
      "description": "Cấu hình hệ thống và link Google Sheets"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Danh sách các thông báo đào tạo"
    },
    "/admin_users/{adminId}": {
      "schema": "AdminUser",
      "description": "Danh sách tài khoản Quản trị viên được cấp quyền"
    },
    "/system_audit_logs/{logId}": {
      "schema": "SystemAuditLog",
      "description": "Nhật ký kiểm toán hoạt động quản trị của toàn hệ thống"
    }
  }
}
